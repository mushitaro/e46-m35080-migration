#!/bin/sh
# This repository is public. No real chip image, no VIN, nothing BMW-derived and no secret may be
# committed - scripts/check-public-tree.mjs knows the shared shapes and scripts/check-bmw-data.mjs
# the ones only this tool meets (NCS coding data, SGBD tables, generated reference data). Both read
# what is STAGED, which is what the commit will actually contain. Installed by
# `npm run hooks:install` (in web/).
node scripts/check-public-tree.mjs --staged || exit 1
exec node scripts/check-bmw-data.mjs --staged
