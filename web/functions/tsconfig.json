{
  // The Workers runtime, not the browser. Kept out of web/tsconfig.json (which
  // excludes functions/) because the two runtimes declare incompatible globals
  // of the same names. Checked by `npm run typecheck`.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}
